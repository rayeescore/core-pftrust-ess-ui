# The Mahindra production build: `npm run build-mahindra`, and the Dockerfile's default BUILD_MODE.
#
# Committed on purpose, like core-pftrust-ui's own .env.mahindra. Nothing here is a secret and nothing
# here can be: Vite inlines every VITE_-prefixed value into the JavaScript bundle, so all four are
# readable by anyone who opens the portal. A secret in this file would be a secret published to every
# visitor. The gitignore rule that used to hide it was the Vite scaffold default, and it only meant the
# production build depended on a file nobody could see — unset, VITE_API_BASE_URL builds a portal that
# calls "undefined/api/v1/me".

# core-pftrust-service. There is no ESS backend: the member surface is part of the admin API's one
# deployment (decided 2026-09-16). This host must match the CSP connect-src in nginx/nginx.conf.
VITE_API_BASE_URL=https://pftrustbodemo.coreintegra.com

VITE_KEYCLOAK_URL=https://sso.coreintegra.com
VITE_KEYCLOAK_REALM=coreintegra-pft

# The member SPA client: public, PKCE, with https://corepftess.mahindra.com/* among its redirect URIs.
# Separate from the admin portal's core-pftrust-app.
VITE_KEYCLOAK_CLIENT_ID=core-pftrust-ess

# Live API, real sign-in. Never 'true' or 'partial' in a deployment: 'true' serves invented data as
# though it were the member's own.
VITE_USE_FIXTURES=false
