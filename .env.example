# Copy to .env.local and adjust. Never commit a filled-in copy.

# core-pftrust-service. There is only one deployment of it (decided 2026-09-16): the member surface is
# part of the admin API, so in production this is https://corepftapi.mahindra.com -- not a separate ESS
# backend. Locally it is the service on 9090.
#
# The production build reads .env.mahindra (Dockerfile: --mode mahindra), which is gitignored and
# supplied at build time. It must name the same host as the CSP's connect-src in nginx/nginx.conf.
VITE_API_BASE_URL=http://localhost:9090

VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=core-root
# A public client, separate from the admin portal's core-pftrust-app, with PKCE required and
# corepftess.mahindra.com in its redirect URIs.
VITE_KEYCLOAK_CLIENT_ID=core-pftrust-ess

# false   every call is live. Honest, and today it leaves most of the dashboard empty.
# true    no API and no sign-in. For looking at screens; never for a deployment.
# partial live where the handler exists, fixtures where it does not -- real sign-in AND a complete
#         dashboard, which is the useful setting while Phase 3 is being built. See src/api/me.js.
VITE_USE_FIXTURES=partial
