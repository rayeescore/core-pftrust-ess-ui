# The same image as Dockerfile, served on port 80 instead of 8080.
#
#   docker build -f Dockerfile.port80 --build-arg BUILD_MODE=mahindra -t core-pftrust-ess-ui:port80 .
#   docker run -p 6064:80 core-pftrust-ess-ui:port80
#
# Stock nginx rather than nginx-unprivileged: a process running as uid 101 cannot bind below 1024 on a
# Docker too old to lower ip_unprivileged_port_start, which the CentOS 7 host's is. The master process
# runs as root to bind 80; the workers still drop to the nginx user.

# Build
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG BUILD_MODE=qa
RUN npm run build -- --mode ${BUILD_MODE}

# Serve
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# One nginx.conf for both images, so the CSP cannot drift between them -- only the listen port is
# rewritten here.
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's/listen 8080;/listen 80;/' /etc/nginx/conf.d/default.conf \
 && grep -q 'listen 80;' /etc/nginx/conf.d/default.conf
EXPOSE 80
